set shell := ["bash", "-cu"]
set export

import "common.just"

# Advanced generation profile: configured multi-stage runs.
PROGRAM_ID := "inc"
STUDY_ID := "brainpower"
PIPELINE_STAGES := "src int program"
MODELS_STAGE_ROOT := "include_kf_dbt_harmonization/models/include"

DD_FORMAT := "ftd_dd"
SOURCE_SCHEMA := "inc_brainpower_raw"
SRC_MATERIALIZED := "table"
FROM_CLAUSE_TEMPLATE := ""
SQL_REFERENCE_DIR := ""
VERSION_LOG := "pipeline_docs/access_version_log.log"

# Inputs to generation: local DD paths and/or in-memory release assets. Defaults to empty, which will cause generation to fail if no DD paths are set.
RELEASE_ASSETS := "inc|project-artifacts.zip"
RELEASE_TAG := "latest"
RELEASE_TOKEN := ""
REFRESH := ""

# Stage DD directory vars can be empty when using RELEASE_ASSETS. Defaults to: <MODELS_STAGE_ROOT>/<study_id>/<stage>
SRC_DD_DIR := "../_study_data/include/brainpower/"
INT_DD_DIR := ""
PROGRAM_DD_DIR := ""

# Optional stage-specific output directory overrides. Defaults to: <MODELS_STAGE_ROOT>/<study_id>/<stage>
SRC_STAGE_DIR := ""
INT_STAGE_DIR := ""
PROGRAM_STAGE_DIR := "include_kf_dbt_harmonization/models/include/_inc_program"

# Optional stage-specific table-prefix overrides.
# When unset, defaults to: <program_id>_<study_id>_<stage>
SRC_TABLE_PREFIX_STAGE := ""
INT_TABLE_PREFIX_STAGE := ""
PROGRAM_TABLE_PREFIX_STAGE := "inc_program"

# Direct-usage pass-through vars for the compatibility wrapper recipes below.
DD_DIR := ""
MODELS_YML := ""
MODELS_DOCS := ""
SOURCES_YML := ""
SOURCES_DOCS := ""
SOURCE_NAME := ""
SQL_DIR := ""
SRC_SQL_DIR := ""
SRC_SOURCE_NAME := ""

default:
    @just --list

help:
    @just --list --unsorted
    @printf '%s\n' '' 'Advanced generation examples (csv path and/or in-memory releases):' \
        '  just -f justfile.advanced STUDY_ID=brainpower generate-stage src' \
        '  just -f justfile.advanced STUDY_ID=brainpower generate-all-stages' \
        '  just -f justfile.advanced STUDY_ID=brainpower generate-pipeline-sql' \
        '  just -f justfile.advanced DD_DIR="" RELEASE_ASSETS="inc|project-artifacts.zip" generate-stage src' \
        '  just -f justfile.advanced INT_TABLE_PREFIX_STAGE=inc_brainpower_int generate-stage-model-sql int' \
        '' \
        'Refresh from GitHub releases is handled in justfile.access only:' \
        '  just -f justfile.access help'

_resolve_stage_env := '
    stage="$STAGE_INPUT"
    study_id="$STUDY_ID"

    case "$stage" in
        src)
            stage_dd_dir="$SRC_DD_DIR"
            stage_dir_override="$SRC_STAGE_DIR"
            stage_table_prefix_override="$SRC_TABLE_PREFIX_STAGE"
            ;;
        int)
            stage_dd_dir="$INT_DD_DIR"
            stage_dir_override="$INT_STAGE_DIR"
            stage_table_prefix_override="$INT_TABLE_PREFIX_STAGE"
            ;;
        program)
            stage_dd_dir="$PROGRAM_DD_DIR"
            stage_dir_override="$PROGRAM_STAGE_DIR"
            stage_table_prefix_override="$PROGRAM_TABLE_PREFIX_STAGE"
            ;;
        *)
            echo "Unknown stage: $stage (expected: src|int|program)" >&2
            exit 2
            ;;
    esac

    if [[ -z "$stage_dd_dir" && -z "$RELEASE_ASSETS" ]]; then
        echo "Set ${stage^^}_DD_DIR or RELEASE_ASSETS before running stage $stage." >&2
        exit 2
    fi

    if [[ -n "$stage_dd_dir" && ! -e "$stage_dd_dir" ]]; then
        if [[ -n "$RELEASE_ASSETS" ]]; then
            stage_dd_dir=""
        else
            echo "Configured DD path does not exist for stage $stage: $stage_dd_dir" >&2
            exit 2
        fi
    fi

    default_stage_dir="$MODELS_STAGE_ROOT/$study_id/$stage"
    stage_dir="${stage_dir_override:-$default_stage_dir}"

    default_stage_table_prefix="${PROGRAM_ID}_${study_id}_${stage}"
    if [[ -n "$stage_table_prefix_override" ]]; then
        stage_table_prefix="$stage_table_prefix_override"
    else
        stage_table_prefix="$default_stage_table_prefix"
    fi

    stage_models_yml="$stage_dir/_models.yml"
    stage_models_docs="$stage_dir/_column_descriptions.md"
    stage_sources_yml="$stage_dir/_sources.yml"
    stage_sources_docs="$stage_dir/_column_descriptions.md"
    stage_sql_dir="$stage_dir"
    stage_src_sql_dir="$stage_dir"
'

# Direct generator wrappers.
generate-models-yml:
    just -f common.just _gen_models

generate-sources-yml:
    just -f common.just _gen_sources

generate-model-sql:
    just -f common.just _gen_model_sql

generate-src-sql:
    just -f common.just _gen_src_sql

generate-stage-models-yml stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    TABLE_PREFIX="$stage_table_prefix" \
    MODELS_YML="$stage_models_yml" \
    MODELS_DOCS="$stage_models_docs" \
    just -f common.just _gen_models

generate-stage-sources-yml stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    TABLE_PREFIX="$stage_table_prefix" \
    SOURCES_YML="$stage_sources_yml" \
    SOURCES_DOCS="$stage_sources_docs" \
    SOURCE_NAME="$STUDY_ID" \
    just -f common.just _gen_sources

generate-stage-model-sql stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    TABLE_PREFIX="$stage_table_prefix" \
    SQL_DIR="$stage_sql_dir" \
    just -f common.just _gen_model_sql

generate-stage-src-sql stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}
    DD_DIR="$stage_dd_dir" \
    TABLE_PREFIX="$stage_table_prefix" \
    SRC_SQL_DIR="$stage_src_sql_dir" \
    SRC_SOURCE_NAME="$STUDY_ID" \
    just -f common.just _gen_src_sql

generate-stage stage:
    #!/usr/bin/env bash
    STAGE_INPUT="{{stage}}"
    {{ _resolve_stage_env }}

    if [[ "{{stage}}" == "src" ]]; then
        DD_DIR="$stage_dd_dir" \
        TABLE_PREFIX="$stage_table_prefix" \
        SOURCES_YML="$stage_sources_yml" \
        SOURCES_DOCS="$stage_sources_docs" \
        SOURCE_NAME="$STUDY_ID" \
        just -f common.just _gen_sources

        DD_DIR="$stage_dd_dir" \
        TABLE_PREFIX="$stage_table_prefix" \
        SRC_SQL_DIR="$stage_src_sql_dir" \
        SRC_SOURCE_NAME="$STUDY_ID" \
        just -f common.just _gen_src_sql
    else
        DD_DIR="$stage_dd_dir" \
        TABLE_PREFIX="$stage_table_prefix" \
        MODELS_YML="$stage_models_yml" \
        MODELS_DOCS="$stage_models_docs" \
        just -f common.just _gen_models

        DD_DIR="$stage_dd_dir" \
        TABLE_PREFIX="$stage_table_prefix" \
        SQL_DIR="$stage_sql_dir" \
        just -f common.just _gen_model_sql
    fi

generate-all-stages:
    #!/usr/bin/env bash
    for stage in $PIPELINE_STAGES; do
        just -f justfile.advanced \
          PROGRAM_ID="$PROGRAM_ID" STUDY_ID="$STUDY_ID" PIPELINE_STAGES="$PIPELINE_STAGES" MODELS_STAGE_ROOT="$MODELS_STAGE_ROOT" \
          DD_FORMAT="$DD_FORMAT" SOURCE_SCHEMA="$SOURCE_SCHEMA" SRC_MATERIALIZED="$SRC_MATERIALIZED" FROM_CLAUSE_TEMPLATE="$FROM_CLAUSE_TEMPLATE" SQL_REFERENCE_DIR="$SQL_REFERENCE_DIR" VERSION_LOG="$VERSION_LOG" \
          RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" \
          SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" \
          SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" \
          SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" \
          generate-stage "$stage"
    done

generate-src-stage-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" generate-stage-src-sql src

generate-int-model-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" generate-stage-model-sql int

generate-program-model-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" generate-stage-model-sql program

generate-pipeline-sql:
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" generate-src-stage-sql
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" generate-int-model-sql
    just -f justfile.advanced STUDY_ID="$STUDY_ID" RELEASE_ASSETS="$RELEASE_ASSETS" RELEASE_TAG="$RELEASE_TAG" RELEASE_TOKEN="$RELEASE_TOKEN" REFRESH="$REFRESH" SRC_DD_DIR="$SRC_DD_DIR" INT_DD_DIR="$INT_DD_DIR" PROGRAM_DD_DIR="$PROGRAM_DD_DIR" SRC_STAGE_DIR="$SRC_STAGE_DIR" INT_STAGE_DIR="$INT_STAGE_DIR" PROGRAM_STAGE_DIR="$PROGRAM_STAGE_DIR" SRC_TABLE_PREFIX_STAGE="$SRC_TABLE_PREFIX_STAGE" INT_TABLE_PREFIX_STAGE="$INT_TABLE_PREFIX_STAGE" PROGRAM_TABLE_PREFIX_STAGE="$PROGRAM_TABLE_PREFIX_STAGE" generate-program-model-sql

clean-dir:
    #!/usr/bin/env bash
    if [[ -d "$SQL_DIR" ]]; then
        find "$SQL_DIR" -type f -name '*_generated.sql' -delete
    fi
